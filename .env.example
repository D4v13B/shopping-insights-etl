# Copiar a .env para ejecutar el ETL fuera de Docker:  cp .env.example .env
# En Docker Compose estas variables las define el docker-compose.yml de shopping-insights-api.

# Conexión como etl_writer (rol creado por infra/postgres/init-roles.sh del repo de la API)
DATABASE_URL_ETL=postgresql://etl_writer:change-me-etl@localhost:5432/shopping

# Kaggle (opcional: sin credenciales se usa data/shopping_trends.csv)
KAGGLE_USERNAME=
KAGGLE_KEY=

LOG_LEVEL=info
# Segundos entre sondeos del worker además de LISTEN/NOTIFY
ETL_WORKER_POLL_SECONDS=30

# Solo para los tests de integración (base migrada con los roles creados)
# TEST_DATABASE_URL_ETL=postgresql://etl_writer:change-me-etl@localhost:5432/shopping
# TEST_DATABASE_URL_ADMIN=postgresql://postgres:change-me@localhost:5432/shopping
